# Frontend environment variables
# Copy this file to .env.local and fill in values for your local environment.
# Never commit .env.local to version control.

# Base URL of the Spring Boot backend API.
# The Vite dev server proxies /api requests to this host automatically,
# so this value is primarily used when building for non-local environments.
VITE_API_BASE_URL=http://localhost:8080/api
